{
  "name": "mock-stock-trade-platform",
  "version": "1.0.0",
  "description": "Real-time mock stock trading backend: Kiwoom REST/WebSocket market-data ingestion, in-memory order book cache, WebSocket broadcast engine, and a virtual leveraged matching engine.",
  "main": "dist/server.js",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only --exit-child src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "start:mock": "MARKET_DATA_SOURCE=mock npm run dev",
    "start:kiwoom": "MARKET_DATA_SOURCE=kiwoom npm run dev",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "ws": "^8.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.10",
    "@types/ws": "^8.5.12",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.3"
  }
}
