# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=8080
HOST=0.0.0.0

# ---------------------------------------------------------------------------
# Market data source: "mock" (default, no credentials needed) or "kiwoom"
# ---------------------------------------------------------------------------
MARKET_DATA_SOURCE=mock

# Symbol(s) to track, comma separated. First symbol is treated as primary.
MARKET_SYMBOLS=005930
MARKET_SYMBOL_NAMES=Samsung Electronics

# ---------------------------------------------------------------------------
# Mock simulator tuning
# ---------------------------------------------------------------------------
MOCK_TICK_INTERVAL_MS=100
MOCK_BASE_PRICE=65400
MOCK_VOLATILITY_BPS=15

# ---------------------------------------------------------------------------
# Kiwoom REST API (https://openapi.kiwoom.com) - only required when
# MARKET_DATA_SOURCE=kiwoom
# ---------------------------------------------------------------------------
# Use the mock-trading (demo) host while developing, switch to the real host
# for production credentials.
KIWOOM_REST_BASE_URL=https://mockapi.kiwoom.com
KIWOOM_WS_URL=wss://mockapi.kiwoom.com:10000/api/dostk/websocket
KIWOOM_APP_KEY=
KIWOOM_APP_SECRET=
# "N" = real trading, "Y" = mock/demo trading account
KIWOOM_IS_MOCK=Y

# ---------------------------------------------------------------------------
# Virtual trading engine
# ---------------------------------------------------------------------------
INITIAL_VIRTUAL_BALANCE=100000000
ALLOWED_LEVERAGES=1,2,3,5

# ---------------------------------------------------------------------------
# WebSocket heartbeat
# ---------------------------------------------------------------------------
WS_HEARTBEAT_INTERVAL_MS=15000
WS_HEARTBEAT_TIMEOUT_MS=30000
